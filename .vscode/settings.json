{
  "files.associations": {
    "*.rep": "xml"
  },
  "files.encoding": "utf8",
  "editor.defaultFormatter": null,
  "xml.format.enabled": true,
  "files.watcherExclude": {
    "**/game_records*/**": true,
    "**/logs/**": true,
    "**/wiki/**": true,
    "**/data/**": true,
    "**/output/**": true
  },
  "search.exclude": {
    "**/game_records*/**": true,
    "**/logs/**": true,
    "**/wiki/**": true
  }
}
