# Large files - Gitee free version doesn't support Git LFS
# 大文件 - Gitee 免费版不支持 Git LFS

# Large document files (>50MB) - exclude from git
# 大文档文件（>50MB）- 从 git 中排除
# Note: Keep markdown versions instead
# 注意：保留 markdown 版本代替
docs/skill/*.docx
docs/skill/*.pdf

# Model files - too large for git repository
# 模型文件 - 文件太大，不适合直接提交到git仓库
# Keep only final models, exclude intermediate checkpoints
# 只保留最终模型，排除中间检查点
models/*epoch_*.pth
models/*test*.pth
models/*quick*.pth
# Keep final models (without epoch/test/quick in name)
# 保留最终模型（名称中不包含epoch/test/quick的）
# models/*.pth  # Uncomment this if you want to exclude ALL model files

# Temporary files
tmp/
*.tmp

# Python cache
__pycache__/
*.pyc
*.pyo

# Environment variables
.env
.env.local
.env.*.local

# Test files
test_*.py
*.md.bak

# Game records and logs
game_records/
logs/

# Windows special files
nul

# Temporary JSON files
execution_state.json
game_scores.json
