# Large files - Gitee free version doesn't support Git LFS
# 大文件 - Gitee 免费版不支持 Git LFS

# Large document files (>50MB) - exclude from git
# 大文档文件（>50MB）- 从 git 中排除
# Note: Keep markdown versions instead
# 注意：保留 markdown 版本代替
docs/skill/*.docx
docs/skill/*.pdf

# Model files - 只忽略中间检查点，保留最终模型
# 模型文件 - 只忽略训练过程中的检查点，最终模型可以推送
# 策略：只推送关键最终模型（约50-100MB），忽略所有epoch检查点
models/**/*_epoch_*.pth
models/**/*_epoch_*.pkl
models/*_epoch_*.pth
models/*_epoch_*.pkl
# 忽略所有.h5文件（通常较大）
models/**/*.h5
models/*.h5

# Temporary files
tmp/
*.tmp

# Python cache
__pycache__/
*.pyc
*.pyo

# Environment variables
.env
.env.local
.env.*.local

# Test files
test_*.py
*.md.bak

# Testscore directory (contains large binary files)
Testscore/

# Game records and logs
game_records/
logs/
*.log

# Windows special files
nul

# Temporary JSON files
execution_state.json
game_scores.json
