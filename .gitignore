# Large files - Gitee free version doesn't support Git LFS
# 大文件 - Gitee 免费版不支持 Git LFS

# Large document files (>50MB) - exclude from git
# 大文档文件（>50MB）- 从 git 中排除
# Note: Keep markdown versions instead
# 注意：保留 markdown 版本代替
docs/archive/skill/*.docx
docs/archive/skill/*.pdf

# Model files - too large for git repository
# 模型文件 - 文件太大，不适合直接提交到git仓库
# Exclude ALL model files to reduce repository size
# 排除所有模型文件以减少仓库大小
models/
models/*.pth
models/*.pkl
models/*.h5
models/*.json
# Model checkpoints (中间检查点)
models/*_epoch_*.pth
models/*checkpoint*.pth
models/*_training_history.json

# Temporary files
tmp/
*.tmp
tmp/.batch_executor.lock
_batch_log.txt
yfscore/

# Python cache
__pycache__/
*.pyc
*.pyo

# Environment variables
.env
.env.local
.env.*.local
config/cos.env

# COS 拉取的 artifact（manifest 在 Git）
data/artifacts/

# 新跑评测 JSON（本地）
data/eval/

# 个人 VS Code 多根工作区（用 docs/dev/*.example 复制）
yifeGDBOT.code-workspace

# Legacy root test/scratch scripts (use tests/ instead)
/test_*.py
/_test_*.py
/debug_test.py
*.md.bak

# Testscore directory (contains large binary files)
Testscore/

# Game records and logs
game_records/*
!game_records/README.md
logs/
training_logs/
trajectories/
*.log

# Windows special files
nul

# Temporary JSON files
execution_state.json
game_scores.json
