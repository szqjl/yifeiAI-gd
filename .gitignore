# Large files - Gitee free version doesn't support Git LFS
# 大文件 - Gitee 免费版不支持 Git LFS

# Large document files (>50MB) - exclude from git
# 大文档文件（>50MB）- 从 git 中排除
# Note: Keep markdown versions instead
# 注意：保留 markdown 版本代替
docs/archive/skill/*.docx
docs/archive/skill/*.pdf

# Model files - too large for git repository
# 模型文件 - 文件太大，不适合直接提交到git仓库
# Exclude ALL model files to reduce repository size
# 排除所有模型文件以减少仓库大小
models/
models/*.pth
models/*.pkl
models/*.h5
models/*.json
# Model checkpoints (中间检查点)
models/*_epoch_*.pth
models/*checkpoint*.pth
models/*_training_history.json

# Temporary files
tmp/
*.tmp
tmp/.batch_executor.lock
_batch_log.txt
yfscore/

# Python cache
__pycache__/
*.pyc
*.pyo

# Environment variables
.env
.env.local
.env.*.local
config/cos.env

# COS 拉取的 artifact（manifest 在 Git）
data/artifacts/

# 新跑评测 JSON（本地）
data/eval/

# 个人 VS Code 多根工作区（用 docs/dev/*.example 复制）
yifeGDBOT.code-workspace

# Legacy root test/scratch scripts (use tests/ instead)
/test_*.py
/_test_*.py
/debug_test.py
*.md.bak

# Testscore directory (contains large binary files)
Testscore/

# Game records and logs
game_records/*
!game_records/README.md
logs/
training_logs/
trajectories/
*.log

# Windows special files
nul

# Temporary JSON files (Layer 2 runtime state — 治理 §6)
execution_state.json
game_scores.json
game_scores_m2.json
batch_executor/current_batch.json

# Hypothesis property-test cache
.hypothesis/

# IDE / local scratch
**/.idea/
.cursor/hooks/         # Cursor IDE 钩子状态（continual-learning 等），按 M-V 治理 §5.5 不入仓
.cursor/hooks/**
tmp_*.py

# V8 game records + decision traces (Layer 2 runtime artifacts, 治理 §6 禁 commit)
game_records_v8/
game_records_v8_kaggle/
game_decision_traces/
_kaggle_*.zip
_kaggle_*.txt
kaggle_upload.zip

# batch_executor runtime state (Layer 2, 与 game_records 同性质)
batch_executor/clients_ready.json
batch_executor/game_ready.json
batch_executor/latest_victory_num.json

# 仓库根 误输入残留 / 调试脚本
/2]
/extra
/_schema.py

# V8 战绩文件（Layer 2 runtime state）
v8_vs_lalala_scores.json
v8_vs_lalala_state.json

# 平台日志（V8 OpenGuanDan 服务器输出）
offline_platform/openguandan_latest/log.txt

# 命令误输入残留（仓库根 临时调试文件）
/2min -m -
/if使fallback始终执行

# Wiki 子工作树缓存产物
wiki/wiki/queries/
