# Large files - Gitee free version doesn't support Git LFS
# 大文件 - Gitee 免费版不支持 Git LFS

# Large document files (>50MB) - exclude from git
# 大文档文件（>50MB）- 从 git 中排除
# Note: Keep markdown versions instead
# 注意：保留 markdown 版本代替
docs/skill/*.docx
docs/skill/*.pdf

# Model files - too large for git repository
# 模型文件 - 文件太大，不适合直接提交到git仓库
# Exclude ALL model files to reduce repository size
# 排除所有模型文件以减少仓库大小
models/
models/*.pth
models/*.pkl
models/*.h5
models/*.json
# Model checkpoints (中间检查点)
models/*_epoch_*.pth
models/*checkpoint*.pth
models/*_training_history.json

# Temporary files
tmp/
*.tmp

# Python cache
__pycache__/
*.pyc
*.pyo

# Environment variables
.env
.env.local
.env.*.local

# Test files
test_*.py
*.md.bak

# Testscore directory (contains large binary files)
Testscore/

# Game records and logs
game_records/
logs/
*.log

# Windows special files
nul

# Temporary JSON files
execution_state.json
game_scores.json
batch_executor/current_batch.json
batch_executor/latest_victory_num.json
batch_executor/clients_ready.json
v7_vs_lalala_scores.json
v7_vs_lalala_state.json

# Test / hypothesis cache
.hypothesis/
.pytest_cache/

# Secrets and local runtime data
config/cos.env
data/

# Offline platform bundle (large; use config/v7_paths.yaml)
# 精确匹配根目录下的 guandan_offline_v1006/（如果有）
# 但不匹配 offline_platform/ 下的（Python 源码需追踪）
/guandan_offline_v1006/
!offline_platform/guandan_offline_v1006/
