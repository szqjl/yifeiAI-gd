# 腾讯云 COS（复制为 config/cos.env 并填写，勿提交 cos.env）
# 控制台：https://console.cloud.tencent.com/cos/bucket

COS_SECRET_ID=你的SecretId
COS_SECRET_KEY=你的SecretKey
COS_REGION=ap-guangzhou
COS_BUCKET=yifei-ai-gd-artifacts-1250000000

# 桶内 artifact 根前缀（整库网盘；留空表示桶内全部，也可填 yifei-ai-gd/）
COS_ARTIFACT_PREFIX=

# 本地与 COS 对齐的「网盘镜像」目录
COS_ARTIFACT_LOCAL=data/artifacts

# 单目录上传/拉取 regression 时使用
COS_PREFIX=replays/regression-lalala-v1/
COS_LOCAL_DIR=data/artifacts/replays/regression-lalala-v1
